# --------------------
# APP ENVIRONMENT
# --------------------
NODE_ENV=development
PORT=3001

# --------------------
# DATABASE
# --------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=doorbuvi_door_shopping
DB_USER=doorbuvi_root
DB_PASSWORD=your_db_password_here

# --------------------
# AUTH
# --------------------
JWT_SECRET=your_jwt_secret_here

# --------------------
# UPLOADS (optional)
# --------------------
# Set to the full path of the folder served at /admin/uploads/ so product images
# uploaded via the management app appear at the same URL as existing images.
# Example (Linux): /var/www/doorshoppin.com/admin/uploads
# If unset, uploads go to backend "uploads" folder (images may need to be served from there).
# ADMIN_UPLOADS_DIR=/path/to/admin/uploads

# --------------------
# DELIVERY FEE CONFIG
# --------------------
# Minimum delivery fee in MWK (default: 1000)
MIN_DELIVERY_FEE=1000

# Maximum order value allowed for cash on delivery in MWK (default: 50000)
CASH_ON_DELIVERY_LIMIT=50000

# Store location (origin for distance calculations)
OFFICE_LAT=-15.7854788
OFFICE_LNG=35.0075824

# Currency: 1 USD = ? MWK  (update when rate changes)
USD_TO_MWK_RATE=3000

# --------------------
# PAYCHANGU (use ONE at a time: sandbox OR live)
# --------------------
# Sandbox: use sk_test_xxxxx — fake money, mode: sandbox
# Live: use sk_live_xxxxx — real money, mode: live
PAYCHANGU_ENV=sandbox
PAYCHANGU_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# Mobile Money Operator Ref IDs (from PayChangu dashboard / GET /mobile-money/operators)
PAYCHANGU_AIRTEL_REF_ID=20be6c20-adeb-4b5b-a7ba-0769820df4fb
PAYCHANGU_TNM_REF_ID=tnm_ref_id_from_paychangu_api

# --------------------
# FIREBASE (FCM push notifications)
# --------------------
# Path to Firebase service account JSON file (relative to project root or absolute).
# Example: service-account-key.json or /home/user/doorshoppin_backend/service-account-key.json
FIREBASE_SERVICE_ACCOUNT_PATH=service-account-key.json

# --------------------
# VONAGE / NEXMO (SMS for phone OTP)
# --------------------
# Get API Key and Secret from https://dashboard.vonage.com
# Brand name = alphanumeric sender ID (e.g. DoorShoppin) shown as "from" on the user's phone.
# Without these, OTP is only logged on the server (dev mode); users will not receive SMS.
# VONAGE_API_KEY=your_api_key
# VONAGE_API_SECRET=your_api_secret
# VONAGE_BRAND_NAME=DoorShoppin

# --------------------
# WHATSAPP CLOUD API (OTP + webhook)
# --------------------
# Meta Developer: https://developers.facebook.com → Create App → Add WhatsApp product.
# Get token: WhatsApp → API Setup → Temporary / System user token.
# Phone number ID: WhatsApp → API Setup → "From" phone number → Phone number ID.
# Verify token: any string you choose; same value in .env and in Meta webhook configuration.
# Plain text OTP: leave WHATSAPP_OTP_TEMPLATE_* commented – OTP is sent as plain text (works only within 24h of user's last message).
# Template OTP (optional): set both below for messages outside 24h; create template in Meta Business Manager first.
# WHATSAPP_ACCESS_TOKEN=your_permanent_or_temporary_token
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# WHATSAPP_VERIFY_TOKEN=doorshoppin_verify
# WHATSAPP_OTP_TEMPLATE_NAME=otp_verification
# WHATSAPP_OTP_TEMPLATE_LANG=en